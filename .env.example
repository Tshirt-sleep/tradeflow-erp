BACKUP_S3_BUCKET=
TRADEFLOW_DATA_DIR=tradeflow-data
TRADEFLOW_DOMAIN=erp.example.com
TRUST_PROXY_HOPS=0
TRADEFLOW_SETUP_TOKEN=
TRADEFLOW_SEED_DEMO_DATA=false
# Next.js AI assistant (server-side only; never use NEXT_PUBLIC_ for secrets)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
BACKUP_S3_REGION=cn-hangzhou
# 阿里云 OSS S3 兼容端点示例（替换成 Bucket 所在地域）
BACKUP_S3_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_S3_PREFIX=tradeflow
# ECS 部署推荐使用实例 RAM 角色；本地可留空并配置下面的专用凭据
BACKUP_S3_CREDENTIAL_MODE=
BACKUP_S3_RAM_ROLE_NAME=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_SESSION_TOKEN=
